# Supabase (projeto do órbitaGO, free tier). Dashboard > Project Settings > API.
SUPABASE_URL=https://<PROJECT_REF>.supabase.co

# Opcional: segredo JWT legado (HS256). Dashboard > Project Settings > JWT Keys > Legacy JWT secret.
# Sem ele, o back valida tokens só via JWKS (chaves assimétricas, recomendado).
SUPABASE_JWT_SECRET=

# Postgres do mesmo projeto. Dashboard > Connect.
# DATABASE_URL: transaction pooler (6543) — usado em runtime pelo Prisma.
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@<POOLER_HOST>:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL: session pooler (5432) ou conexão direta — só para `prisma migrate deploy`.
DIRECT_URL="postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@<POOLER_HOST>:5432/postgres"

# Origem(ns) do frontend, separadas por vírgula (CORS allowlist — nunca "*")
FRONTEND_URL=http://localhost:3000

PORT=3333

# Swagger/OpenAPI em GET /docs (default: ligado).
SWAGGER_ENABLED=true

# Web Push (VAPID) — par de chaves para enviar notificação push (front usa
# VAPID_PUBLIC_KEY como NEXT_PUBLIC_VAPID_PUBLIC_KEY). Gerar com:
#   npx web-push generate-vapid-keys
# Nunca commitar a private key de verdade — os valores reais ficam só no .env.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@exemplo.com

# Segredo do cron (GitHub Actions) que chama POST /internal/dispatch-reminders
# via header X-Cron-Secret — NÃO é um JWT de usuário. Gerar com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Configure o mesmo valor como secret CRON_SECRET no repo do GitHub.
CRON_SECRET=
