generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

enum Theme {
  light
  dark
  system
}

enum TransactionType {
  expense
  income
}

enum Frequency {
  monthly
  weekly
  yearly
}

enum Priority {
  high
  medium
  low
}

/// Coluna do quadro Kanban. `done` é espelho de `Task.done` (mantidos em sincronia).
enum TaskStatus {
  backlog
  todo
  doing
  done
}

enum ReminderKind {
  finance
  task
  note
}

enum ReminderRepeat {
  none
  daily
  weekly
  monthly
}

enum GoalFrequency {
  weekly
  biweekly
  monthly
}

enum ObjectiveHorizon {
  short
  medium
  long
}

enum LifeEventKind {
  achievement
  project
  milestone
}

/// Pessoa autenticada — id = `sub` do JWT do Supabase Auth (upsert no 1º request).
/// Guarda também o estado de gamificação (nível, XP, moedas, ofensiva, loja).
model User {
  id                   String    @id @db.Uuid
  email                String
  name                 String?
  avatarUrl            String?   @map("avatar_url")
  onboarded            Boolean   @default(false)
  level                Int       @default(1)
  xp                   Int       @default(0)
  coins                Int       @default(0)
  streak               Int       @default(0)
  streakRecord         Int       @default(0) @map("streak_record")
  shields              Int       @default(0)
  lastClosedDay        DateTime? @map("last_closed_day") @db.Date
  theme                Theme     @default(system)
  notificationsEnabled Boolean   @default(false) @map("notifications_enabled")
  monthlyIncomeCents   Int?      @map("monthly_income_cents")
  ownedItems           String[]  @default([]) @map("owned_items")
  enabledCategoryKeys  String[]  @default([]) @map("enabled_category_keys")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  accounts          Account[]
  transactions      Transaction[]
  recurrings        Recurring[]
  budgets           Budget[]
  goals             Goal[]
  tasks             Task[]
  reminders         Reminder[]
  missions          MissionClaim[]
  streakDays        StreakDay[]
  bossStates        BossState[]
  bossAttacks       BossAttack[]
  achievements      UserAchievement[]
  pushSubscriptions PushSubscription[]
  habits            Habit[]
  flashcards        Flashcard[]
  apiTokens         ApiToken[]
  objectives        Objective[]
  challenges        Challenge[]
  lifeEvents        LifeEvent[]
  notes             Note[]

  @@map("users")
}

model Account {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String
  icon      String
  /// Hex fixa por conta seedada (Nubank roxo, Itaú laranja, Carteira verde).
  color     String   @default("#9A8C7E")
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  recurrings   Recurring[]

  @@index([userId])
  @@map("accounts")
}

model Transaction {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String          @map("user_id") @db.Uuid
  type        TransactionType
  amountCents Int             @map("amount_cents")
  description String
  categoryKey String          @map("category_key")
  date        DateTime        @db.Date
  accountId   String?         @map("account_id") @db.Uuid
  recurringId String?         @map("recurring_id") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  account   Account?          @relation(fields: [accountId], references: [id], onDelete: SetNull)
  recurring Recurring?        @relation(fields: [recurringId], references: [id], onDelete: SetNull)
  payment   RecurringPayment?

  @@index([userId, date])
  @@index([userId, createdAt])
  @@map("transactions")
}

/// Conta/receita fixa. `startDate` ancora a 1ª ocorrência (e o mês das anuais);
/// semanal usa `dueDay % 7` como dia da semana (0 = domingo).
model Recurring {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String          @map("user_id") @db.Uuid
  description String
  amountCents Int             @map("amount_cents")
  categoryKey String          @map("category_key")
  type        TransactionType
  frequency   Frequency
  dueDay      Int             @map("due_day")
  startDate   DateTime        @map("start_date") @db.Date
  endDate     DateTime?       @map("end_date") @db.Date
  accountId   String?         @map("account_id") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  account      Account?           @relation(fields: [accountId], references: [id], onDelete: SetNull)
  payments     RecurringPayment[]
  transactions Transaction[]
  bossStates   BossState[]

  @@index([userId])
  @@map("recurrings")
}

/// Pagamento de uma ocorrência. `period`: YYYY-MM (mensal), YYYY (anual), YYYY-MM-DD (semanal).
model RecurringPayment {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recurringId   String   @map("recurring_id") @db.Uuid
  period        String
  dueDate       DateTime @map("due_date") @db.Date
  onTime        Boolean  @map("on_time")
  paidAt        DateTime @default(now()) @map("paid_at") @db.Timestamptz(6)
  transactionId String?  @unique @map("transaction_id") @db.Uuid

  recurring   Recurring    @relation(fields: [recurringId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@unique([recurringId, period])
  @@map("recurring_payments")
}

model Budget {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String @map("user_id") @db.Uuid
  categoryKey String @map("category_key")
  limitCents  Int    @map("limit_cents")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryKey])
  @@map("budgets")
}

/// Meta em trilha de 10 passos; baús após os passos 3 e 7 (`chestsOpened`).
model Goal {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String         @map("user_id") @db.Uuid
  name             String
  icon             String
  targetCents      Int            @map("target_cents")
  savedCents       Int            @default(0) @map("saved_cents")
  /// Quanto guardar por vez (sugestão da trilha). Nulo = gerado (target/10).
  installmentCents Int?           @map("installment_cents")
  chestsOpened     Int[]          @default([]) @map("chests_opened")
  /// Prazo opcional definido pelo usuário, formato YYYY-MM (mês/ano — não dia).
  deadline         String?
  /// Cadência dos aportes sugeridos (só usada com `deadline`); nulo = trilha por dinheiro (10 passos fixos).
  frequency        GoalFrequency?
  /// Data (YYYY-MM-DD) de onde a trilha por data começa a contar; reseta pra hoje sempre que
  /// targetCents, deadline ou frequency mudam — é isso que "regenera" a trilha.
  trailStartDate   String?        @map("trail_start_date")
  completedAt      DateTime?      @map("completed_at") @db.Timestamptz(6)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("goals")
}

model Task {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  title       String
  dueDate     DateTime? @map("due_date") @db.Date
  priority    Priority  @default(medium)
  reminderAt  String?   @map("reminder_at")
  done        Boolean   @default(false)
  doneAt      DateTime? @map("done_at") @db.Timestamptz(6)
  /// Coluna no quadro Kanban; `done` ⇔ status = done.
  status      TaskStatus @default(todo)
  /// Ordem do card dentro da coluna (fracionária: inserir entre dois = média).
  position    Float      @default(0)
  /// XP de conclusão é pago uma única vez por tarefa (evita farm com complete/uncomplete).
  xpAwarded   Boolean   @default(false) @map("xp_awarded")
  /// Meta (Objective) a que a tarefa contribui; conta no % de conclusão da meta.
  objectiveId String?   @map("objective_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminder  Reminder?
  objective Objective? @relation(fields: [objectiveId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("tasks")
}

model Reminder {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String         @map("user_id") @db.Uuid
  title       String
  kind        ReminderKind
  time        String
  repeat      ReminderRepeat
  dayOfMonth  Int?           @map("day_of_month")
  weekday     Int?
  date        DateTime?      @db.Date
  enabled     Boolean        @default(true)
  /// Dedupe do cron de push: última vez que essa ocorrência foi disparada.
  lastFiredAt DateTime?      @map("last_fired_at") @db.Timestamptz(6)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Preenchido só para lembretes derivados de `Task.reminderAt` (kind = task) — permite sync/cascade.
  taskId      String?        @unique @map("task_id") @db.Uuid
  /// Preenchido só para lembretes derivados de `Note.reminderAt` (kind = note).
  noteId      String?        @unique @map("note_id") @db.Uuid

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: Cascade)
  note Note? @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("reminders")
}

/// Inscrição de Web Push de um dispositivo/navegador (endpoint = identidade única).
model PushSubscription {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model MissionClaim {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  missionKey String   @map("mission_key")
  day        DateTime @db.Date
  claimedAt  DateTime @default(now()) @map("claimed_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, missionKey, day])
  @@map("mission_claims")
}

/// Dia fechado (ofensiva). `shielded` = dia salvo por escudo.
model StreakDay {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  day      DateTime @db.Date
  shielded Boolean  @default(false)
  closedAt DateTime @default(now()) @map("closed_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@map("streak_days")
}

/// Chefão do mês: snapshot da maior recorrente de saída no 1º acesso do mês.
model BossState {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  month       String
  name        String
  icon        String
  maxHpCents  Int       @map("max_hp_cents")
  damageCents Int       @default(0) @map("damage_cents")
  /// Recorrente de origem do snapshot — permite calcular o `dueDate` do mês.
  recurringId String?   @map("recurring_id") @db.Uuid
  defeatedAt  DateTime? @map("defeated_at") @db.Timestamptz(6)

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  recurring Recurring? @relation(fields: [recurringId], references: [id], onDelete: SetNull)

  @@unique([userId, month])
  @@map("boss_states")
}

model BossAttack {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  month       String
  amountCents Int      @map("amount_cents")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, month])
  @@map("boss_attacks")
}

model UserAchievement {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  achievementKey String   @map("achievement_key")
  unlockedAt     DateTime @default(now()) @map("unlocked_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementKey])
  @@map("user_achievements")
}

/// Hábito recorrente: marcado por dia nos `weekdays` (0 = domingo … 6 = sábado).
/// `reminderTime` opcional dispara push só se o hábito do dia não foi marcado.
model Habit {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  name         String
  icon         String
  color        String
  weekdays     Int[]     @default([0, 1, 2, 3, 4, 5, 6])
  reminderTime String?   @map("reminder_time")
  /// Dedupe do cron de push (mesma regra de `Reminder.lastFiredAt`).
  lastFiredAt  DateTime? @map("last_fired_at") @db.Timestamptz(6)
  /// Meta (Objective) que o hábito sustenta (não entra no %; mostra consistência).
  objectiveId  String?   @map("objective_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  checks    HabitCheck[]
  objective Objective?   @relation(fields: [objectiveId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("habits")
}

model HabitCheck {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  habitId   String   @map("habit_id") @db.Uuid
  day       DateTime @db.Date
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, day])
  @@map("habit_checks")
}

/// Card de vocabulário (inglês). Criado pela tela ou pelo Claude via MCP.
/// Revisão simples: acertos/erros e `lastReviewedAt` ordenam a fila de revisão.
model Flashcard {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  /// Termo em português (o que a pessoa não sabia dizer).
  pt             String
  /// Tradução em inglês no contexto em que foi usada.
  en             String
  example        String?
  note           String?
  correctCount   Int       @default(0) @map("correct_count")
  wrongCount     Int       @default(0) @map("wrong_count")
  lastReviewedAt DateTime? @map("last_reviewed_at") @db.Timestamptz(6)
  /// Repetição espaçada (ver src/flashcards/srs.ts): new | learning | review | relearning.
  srsState       String    @default("new") @map("srs_state")
  /// Passo atual dentro de learning/relearning.
  srsStep        Int       @default(0) @map("srs_step")
  /// Fator de facilidade (multiplica o intervalo a cada "Lembrei").
  ease           Float     @default(2.5)
  intervalDays   Int       @default(0) @map("interval_days")
  lapses         Int       @default(0)
  /// Quando o card volta para a revisão; null = card novo (nunca estudado).
  dueAt          DateTime? @map("due_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, pt, en])
  @@index([userId, lastReviewedAt])
  @@index([userId, dueAt])
  @@map("flashcards")
}

/// Token pessoal para clientes externos (servidor MCP). Só o hash SHA-256 é salvo;
/// o valor em claro aparece uma única vez, na criação.
model ApiToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  name       String
  tokenHash  String    @unique @map("token_hash")
  /// Primeiros caracteres do token, para a pessoa reconhecer qual é qual.
  prefix     String
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_tokens")
}

/// Meta geral (Goals & OKRs) — diferente de `Goal`, que é meta de economia.
/// % de conclusão = (etapas feitas + tarefas vinculadas feitas) / (etapas + tarefas vinculadas).
model Objective {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  title          String
  /// Por que essa meta importa (motivação).
  why            String?
  /// Resultado esperado / key result ("conversar 30 min sem travar").
  expectedResult String?          @map("expected_result")
  horizon        ObjectiveHorizon
  deadline       DateTime?        @db.Date
  icon           String
  color          String
  completedAt    DateTime?        @map("completed_at") @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestones ObjectiveMilestone[]
  tasks      Task[]
  habits     Habit[]

  @@index([userId])
  @@map("objectives")
}

/// Etapa de uma meta (dividir objetivos grandes em pequenas entregas).
model ObjectiveMilestone {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  objectiveId String    @map("objective_id") @db.Uuid
  title       String
  done        Boolean   @default(false)
  doneAt      DateTime? @map("done_at") @db.Timestamptz(6)
  position    Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  objective Objective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)

  @@index([objectiveId])
  @@map("objective_milestones")
}

/// Desafio de N dias (7, 21 ou 30) com check-in diário.
model Challenge {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  title        String
  why          String?
  durationDays Int       @map("duration_days")
  startDate    DateTime  @map("start_date") @db.Date
  icon         String
  color        String
  /// Todos os dias cumpridos.
  completedAt  DateTime? @map("completed_at") @db.Timestamptz(6)
  /// A pessoa desistiu (mantém o histórico).
  abandonedAt  DateTime? @map("abandoned_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  checks ChallengeCheck[]

  @@index([userId])
  @@map("challenges")
}

model ChallengeCheck {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  challengeId String   @map("challenge_id") @db.Uuid
  day         DateTime @db.Date
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([challengeId, day])
  @@map("challenge_checks")
}

/// Evento da linha do tempo registrado à mão (conquista, projeto concluído, marco da vida).
model LifeEvent {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  title       String
  description String?
  date        DateTime      @db.Date
  kind        LifeEventKind
  icon        String
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("life_events")
}

/// Nota rápida (estilo Keep): texto livre ou checklist, com cor, etiquetas e lembrete.
model Note {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  title      String    @default("")
  body       String    @default("")
  /// Chave da paleta (default, red, orange, yellow, green, teal, blue, purple, pink, gray).
  color      String    @default("default")
  labels     String[]  @default([])
  /// true = nota é checklist (`items`); false = texto (`body`).
  checklist  Boolean   @default(false)
  /// Itens do checklist: [{ id, text, done }].
  items      Json      @default("[]")
  pinned     Boolean   @default(false)
  /// Datetime ISO com offset; espelhado num Reminder (kind = note) pro cron de push.
  reminderAt String?   @map("reminder_at")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminder Reminder?

  @@index([userId])
  @@map("notes")
}
